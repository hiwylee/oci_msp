REGIONS=("ap-seoul-1" "us-chicago-1")

# OCI CLI profile name (maps to ~/.oci/config section)
OCI_PROFILE="DEFAULT"

# Tenancy OCID (used by 'compartments' command)
TENANCY_ID="ocid1.tenancy.oc1..xxxx"

# Optional tag filter
TAG_FILTER="env=prod"

MAX_RETRIES=3
RETRY_DELAY=2

LOG_FILE="oci-automation.log"
COMPARTMENT_ID="ocid1.compartment.oc1..xxxx"
